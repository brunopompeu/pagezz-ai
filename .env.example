# Google Gemini (primário)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback automático)
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Page Model (Cerebras ou compatível)
PAGE_MODEL_API_KEY=
PAGE_MODEL_NAME=zai-glm-4.7
PAGE_MODEL_BASE_URL=https://api.cerebras.ai/v1/chat/completions

# Page Model Fallback (Z.AI)
PAGE_MODEL_FALLBACK_API_KEY=
PAGE_MODEL_FALLBACK_NAME=glm-4.7-flash
PAGE_MODEL_FALLBACK_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions

# Supabase (opcional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
