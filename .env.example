# ── Camada 1: Agentes (raciocínio) ──────────────────────────────
# Cadeia com fallback automático na ordem: OpenRouter → Gemini → Groq

# OpenRouter (1º da cadeia, quando configurado)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o

# Google Gemini (2º da cadeia)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback final)
GROQ_API_KEY=

# ── Camada 2: Geração de HTML (slot trocável) ───────────────────
# Cadeia com fallback automático: primário → fallback

# Primário (Cerebras ou qualquer endpoint OpenAI-compatible)
PAGE_MODEL_API_KEY=
PAGE_MODEL_NAME=zai-glm-4.7
PAGE_MODEL_BASE_URL=https://api.cerebras.ai/v1/chat/completions

# Fallback (Z.AI)
PAGE_MODEL_FALLBACK_API_KEY=
PAGE_MODEL_FALLBACK_NAME=glm-4.7-flash
PAGE_MODEL_FALLBACK_BASE_URL=https://api.z.ai/api/paas/v4/chat/completions

# ── Supabase (contas, não usado na geração) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
